<Window x:Class="WindowsBlocker.TimerOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        ResizeMode="NoResize" SizeToContent="WidthAndHeight"
        Focusable="False" IsHitTestVisible="False">
    <Border CornerRadius="10" Padding="10,8" Background="#DB0F172A" SnapsToDevicePixels="True">
        <TextBlock x:Name="Rows" Foreground="#F8FAFC" FontFamily="Arial" FontSize="13" Typography.NumeralAlignment="Tabular" LineHeight="18" TextTrimming="CharacterEllipsis"/>
    </Border>
</Window>
